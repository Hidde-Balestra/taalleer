<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nodig voor de update-check (GitHub API) en tekst-naar-spraak-download
         op sommige toestellen. In debug/profile stond dit al (alleen voor
         ontwikkeling), maar ontbrak hier voor release-builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voor de dagelijkse oefenherinnering (flutter_local_notifications).
         Android 13+ vereist expliciete toestemming om notificaties te tonen;
         RECEIVE_BOOT_COMPLETED laat de geplande herinnering een reboot
         overleven. Bewust géén SCHEDULE_EXACT_ALARM: de herinnering hoeft
         niet minuutnauwkeurig, dus inexact schedulen volstaat en dat
         vereist geen gevoelige permissie. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="taalleer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Startscherm-widget: toont streak en weeknummer, data komt van
             Flutter via lib/home_widget_service.dart (home_widget-package). -->
        <receiver
            android:name=".TaalLeerWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/taalleer_widget_info"/>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Nodig om op Android 11+ een tekst-naar-spraak-engine te kunnen
             vinden (package-visibility), zie flutter_tts. Dit is de actie
             die TTS-engines (RHVoice, eSpeak NG, ...) zelf declareren; zonder
             deze <queries>-regel "ziet" onze app die engines niet, ook al
             staan ze systeembreed gewoon actief. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
